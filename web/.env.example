# This app accepts research mode and test payments only.
SAJU_MODE=research
PAYMENT_PROVIDER=mock
APP_ORIGIN=http://127.0.0.1:4180
# Optional external PostgreSQL (server-only). Default: web/.data/postgres, one Node process.
# DATABASE_URL=postgresql://...
# Test keys only. Do not put secret keys in NEXT_PUBLIC_ variables.
# PAYMENT_PROVIDER=toss-test
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...
# Remote staging must be explicitly configured after infrastructure review.
# ALLOW_REMOTE_TEST=true
# Preferred PG: same provider as the local Danielsnote ebook platform.
# PAYMENT_PROVIDER=nicepay-test
# NICEPAY_MODE=sandbox
# NICEPAY_CLIENT_KEY=S2_...
# NICEPAY_SECRET_KEY=...
# Supabase Auth (Kakao enabled in its dashboard); only the publishable key is needed.
# SUPABASE_URL=https://your-test-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase redirect allowlist: APP_ORIGIN/auth/callback
