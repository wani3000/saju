{
  "name": "saju-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "engine": "node scripts/prepare-engine.mjs",
    "dev": "npm run engine && next dev --webpack --hostname 127.0.0.1 --port 4180",
    "build": "npm run engine && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4180",
    "test": "npm run engine && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx scripts/worker.ts",
    "db:check": "tsx scripts/db-check.ts",
    "test:http": "node tests/http.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "health": "tsx scripts/maintenance.ts --health",
    "recovery:manifest": "npm run engine && tsx scripts/recovery-manifest.ts",
    "recovery:check": "tsx scripts/check-recovery-compatibility.ts",
    "reading:audit": "npm run engine && tsx scripts/audit-reviewed-dialogue.ts",
    "test:postgres": "node scripts/postgres-check.mjs",
    "test:hosted-runtime": "tsx scripts/check-hosted-runtime.ts",
    "test:hosted-restore": "tsx scripts/check-hosted-restore.ts",
    "test:kakao-provider": "tsx scripts/check-kakao-provider.ts",
    "test:journey": "node scripts/check-journey.mjs",
    "check:staging": "tsx scripts/staging.ts",
    "start:staging": "tsx scripts/staging.ts --start",
    "build:preview": "npm run engine && node preview/build.mjs",
    "narration:prepare": "npm run engine && tsx scripts/compare-narration.ts --offline",
    "narration:compare": "npm run engine && tsx scripts/compare-narration.ts --live",
    "narration:summarize": "tsx scripts/summarize-narration.ts",
    "narration:audit": "npm run engine && tsx scripts/audit-narration-preparation.ts",
    "release:inventory": "npm run engine && tsx scripts/release-source-inventory.ts",
    "test:kakao": "node scripts/check-journey.mjs --kakao-required",
    "test:nicepay": "node scripts/check-journey.mjs --nicepay-sandbox",
    "check:nicepay-webhook": "tsx scripts/check-nicepay-registration.ts",
    "retention": "tsx scripts/retention.ts",
    "backup:file": "tsx scripts/backup.ts",
    "alerts:plan": "tsx scripts/alert-plan.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@fontsource/jua": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/noto-serif-kr": "5.3.1",
    "@karrotmarket/react-monochrome-icon": "1.30.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tosspayments/tosspayments-sdk": "2.9.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
