# Copy to .env.staging.local (ignored by Git), then fill using dedicated test services.
# Never copy production ebook-service keys or its database.
SAJU_MODE=research
SAJU_AUTH_MODE=kakao-required
APP_ORIGIN=
ALLOW_REMOTE_TEST=true
# Separate PostgreSQL; include sslmode=verify-full and initialize migrations/roles separately.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PAYMENT_PROVIDER=nicepay-test
NICEPAY_MODE=sandbox
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
# The hosting access boundary is configured and tested separately, not by ALLOW_REMOTE_TEST.
